diff -ruN a/migrations/0048_kirigo_escrow.sql b/migrations/0048_kirigo_escrow.sql
--- a/migrations/0048_kirigo_escrow.sql	1970-01-01 12:00:00.000000000 +1200
+++ b/migrations/0048_kirigo_escrow.sql	2026-11-11 00:00:59.984077557 +1200
@@ -0,0 +1,52 @@
+-- 0048: KiriGo delivery escrow (worker/kirigo.ts).
+--
+-- A customer pays goods + delivery once into a HOLD. Each hold is its own ledger account (id = the hold id, owner_id NULL),
+-- exactly like a cash voucher (0030): nobody can cash it out or spend it, and CHECK (balance >= 0) on accounts means it can
+-- never pay out more than was put in. KiriGo's server then releases parts of it (driver at handoff, shop on acceptance)
+-- or refunds it. KiriGo never holds money itself.
+CREATE TABLE escrow_holds (
+  id TEXT PRIMARY KEY,                       -- hld_…, also the id of this hold's ledger account
+  payer_id TEXT NOT NULL REFERENCES users(id),
+  amount INTEGER NOT NULL CHECK (amount > 0),
+  released INTEGER NOT NULL DEFAULT 0 CHECK (released >= 0),
+  refunded INTEGER NOT NULL DEFAULT 0 CHECK (refunded >= 0),
+  ref TEXT UNIQUE,                           -- the KiriGo order this hold pays for (set once, never changed)
+  status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open','closed')),
+  hold_tx TEXT NOT NULL,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
+);
+CREATE INDEX idx_escrow_holds_payer ON escrow_holds(payer_id, created_at);
+-- never more out than in, even if two calls land at the same moment (the whole move is undone)
+CREATE TRIGGER escrow_holds_cap BEFORE UPDATE OF released, refunded ON escrow_holds
+WHEN NEW.released + NEW.refunded > NEW.amount
+BEGIN SELECT RAISE(ABORT, 'more than the hold'); END;
+-- a hold's order, payer and amount are fixed once written
+CREATE TRIGGER escrow_holds_fixed BEFORE UPDATE ON escrow_holds
+WHEN NEW.id IS NOT OLD.id OR NEW.payer_id IS NOT OLD.payer_id OR NEW.amount IS NOT OLD.amount OR NEW.hold_tx IS NOT OLD.hold_tx
+  OR (OLD.ref IS NOT NULL AND NEW.ref IS NOT OLD.ref)
+BEGIN SELECT RAISE(ABORT, 'hold details are fixed'); END;
+CREATE TRIGGER escrow_holds_no_delete BEFORE DELETE ON escrow_holds BEGIN SELECT RAISE(ABORT, 'holds are kept'); END;
+
+-- every release and refund out of a hold, with its ledger transaction. Append-only.
+CREATE TABLE escrow_moves (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  hold_id TEXT NOT NULL REFERENCES escrow_holds(id),
+  action TEXT NOT NULL CHECK (action IN ('release','refund')),
+  to_account TEXT NOT NULL,
+  amount INTEGER NOT NULL CHECK (amount > 0),
+  transaction_id TEXT NOT NULL,              -- the ledger transaction (no FOREIGN KEY: this row is written in the same batch, just before it)
+  idempotency_key TEXT NOT NULL UNIQUE,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
+);
+CREATE INDEX idx_escrow_moves_hold ON escrow_moves(hold_id);
+CREATE TRIGGER escrow_moves_no_update BEFORE UPDATE ON escrow_moves BEGIN SELECT RAISE(ABORT, 'escrow moves are append-only'); END;
+CREATE TRIGGER escrow_moves_no_delete BEFORE DELETE ON escrow_moves BEGIN SELECT RAISE(ABORT, 'escrow moves are append-only'); END;
+
+-- one-time codes for "Sign in with KiriPay" (KiriGo driver app and admin). Only a hash is stored; a code works once, for 5 minutes.
+CREATE TABLE kirigo_auth_codes (
+  code_hash TEXT PRIMARY KEY,
+  user_id TEXT NOT NULL REFERENCES users(id),
+  mfa INTEGER NOT NULL DEFAULT 0,
+  created_at TEXT NOT NULL,
+  used_at TEXT
+);
